rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // === ХЕЛПЕРЫ ПРАВ ===
    // владелец: uid записан в meta/owner
    function isOwner() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/meta/owner) &&
        get(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid;
    }
    // админ: роль сотрудника, привязанного к моему uid через usermap
    function myDeviceId() {
      return get(/databases/$(database)/documents/usermap/$(request.auth.uid)).data.deviceId;
    }
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usermap/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/employees/$(myDeviceId())) &&
        get(/databases/$(database)/documents/employees/$(myDeviceId())).data.role in ['admin'];
    }
    // bootstrap владельца при пустом meta/owner (первый запуск устройства)
    function ownerBootstrap() {
      return request.auth != null && !exists(/databases/$(database)/documents/meta/owner);
    }

    match /app/state {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /usermap/{uid} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }
    match /requests/{deviceId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /employees/{deviceId} {
      allow read: if true;
      // приём сотрудника владельцем/админом; bootstrap владельца при пустом meta
      allow create: if isOwner() || isAdmin() ||
        (ownerBootstrap() && request.resource.data.owner == true);
      // своему устройству — только профиль и uid-привязка; владельцу/админу — любые поля
      allow update: if isOwner() || isAdmin() ||
        (request.auth != null &&
         request.auth.uid == resource.data.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile','uid']));
      // увольнение — только владелец/админ
      allow delete: if isOwner() || isAdmin();
    }
    match /roles/{roleId} {
      allow read: if true;
      allow create, update, delete: if isOwner() || isAdmin();
    }
    match /photos/{photoId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      // удалить может автор фото (by == deviceId из usermap) либо владелец/админ
      allow delete: if isOwner() || isAdmin() ||
        (request.auth != null &&
         exists(/databases/$(database)/documents/usermap/$(request.auth.uid)) &&
         resource.data.by == get(/databases/$(database)/documents/usermap/$(request.auth.uid)).data.deviceId);
    }
    match /orders/{orderId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /meta/{doc} {
      allow read: if true;
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/meta/$(doc));
      allow update, delete: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}