rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /app/state {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /requests/{deviceId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /employees/{deviceId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /roles/{roleId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /meta/{doc} {
      allow read: if true;
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/meta/$(doc));
      allow update, delete: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
